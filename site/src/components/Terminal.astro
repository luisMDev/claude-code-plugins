---
// A Claude Code session drawn in HTML: the transcript, the plugin's band above
// the prompt and its pane on the right. Pressing a capsule swaps the pane.
import type { Button } from '../plugins'

interface Props {
  id: string
  buttons: Button[]
}
const { id, buttons } = Astro.props
---

<figure class="term" data-term={id}>
  <div class="bar" aria-hidden="true">
    <span class="dot"></span><span class="dot"></span><span class="dot"></span>
    <span class="where">claude · ~/Projects/claude-code-plugins</span>
  </div>
  <div class="body">
    <div class="session">
      <p><span class="clay">❯</span> build a landing page for the plugins</p>
      <p><span class="green">●</span> Write(<span class="ink">site/src/pages/index.astro</span>)</p>
      <p class="dim">&nbsp;&nbsp;└ Wrote 180 lines</p>
      <p class="clay">✻ <span class="dim">Churned for 41s</span></p>
      <div class="band">
        {buttons.map((b, i) => (
          <button
            type="button"
            class="pill"
            style={`--c:${b.color}`}
            data-pick={i}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {b.label}
          </button>
        ))}
        <span class="dim">·</span>
      </div>
      <div class="prompt"><span class="dim">❯</span><span class="caret"></span></div>
    </div>
    <aside class="pane" aria-live="polite">
      {buttons.map((b, i) => (
        <div class="answer" data-answer={i} hidden={i !== 0}>
          <header>
            <span class="pill static" style={`--c:${b.color}`}>{b.label}</span>
            <span class="dim">{b.subtitle} · 12s</span>
          </header>
          <hr />
          {b.answer.map((line) =>
            line.startsWith('## ') ? (
              <p class="h" style={`color:${b.color}`}>{line.slice(3)}</p>
            ) : (
              <p>{line || ' '}</p>
            ),
          )}
          <hr />
          <footer>
            <span class="pill static">↻ Again</span>
            <span class="pill static">Copy</span>
            <span class="pill static">✕ Close</span>
          </footer>
        </div>
      ))}
    </aside>
  </div>
</figure>

<script>
  for (const term of document.querySelectorAll<HTMLElement>('[data-term]')) {
    const picks = term.querySelectorAll<HTMLButtonElement>('[data-pick]')
    for (const pick of picks) {
      pick.addEventListener('click', () => {
        for (const p of picks) p.setAttribute('aria-pressed', String(p === pick))
        for (const a of term.querySelectorAll<HTMLElement>('[data-answer]')) {
          a.hidden = a.dataset.answer !== pick.dataset.pick
        }
      })
    }
  }
</script>

<style>
  .term {
    margin: 0;
    background: var(--term-bg);
    color: var(--term-ink);
    border: 1px solid var(--term-rule);
    border-radius: 10px;
    overflow: hidden;
    font-size: 13px;
    line-height: 1.55;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 9px 12px;
    border-bottom: 1px solid var(--term-rule);
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--term-rule);
  }
  .where {
    margin-left: 8px;
    color: var(--term-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }
  .session,
  .pane {
    padding: 14px 16px;
    min-width: 0;
  }
  .pane {
    border-left: 1px solid var(--term-rule);
  }
  p {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .dim {
    color: var(--term-dim);
  }
  .clay {
    color: var(--accent);
  }
  .green {
    color: #7fd18b;
  }
  .ink {
    color: var(--term-ink);
  }
  .band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 1.55em;
  }
  .pill {
    font: inherit;
    font-weight: 700;
    color: var(--c, #ebdbb2);
    background: #504945;
    border: 0;
    border-radius: 999px;
    padding: 0 0.8em;
    line-height: 1.55;
    white-space: nowrap;
  }
  button.pill {
    cursor: pointer;
    outline-offset: 2px;
  }
  button.pill[aria-pressed='true'] {
    box-shadow: 0 0 0 1px var(--c);
  }
  .prompt {
    margin-top: 8px;
    padding: 4px 10px;
    border: 1px solid var(--term-rule);
    border-radius: 6px;
  }
  .caret {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 0.5em;
    vertical-align: text-bottom;
    background: var(--term-ink);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  header,
  footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  hr {
    border: 0;
    border-top: 1px solid var(--term-rule);
    margin: 10px 0;
  }
  .h {
    font-weight: 700;
    margin-top: 0.5em;
  }
  .h:first-of-type {
    margin-top: 0;
  }
  @media (max-width: 640px) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }
    .pane {
      border-left: 0;
      border-top: 1px solid var(--term-rule);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }
</style>
