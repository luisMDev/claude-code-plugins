---
// A Claude Code window that plays a plugin's demo (scripts/demos.ts): the
// session on the left, the band above the prompt, and the plugin's pane
// sliding in from the right, driven by a pointer.
import type { Button } from '../plugins'

interface Props {
  id: string
  buttons: Button[]
}
const { id, buttons } = Astro.props
---

<figure class="term" data-demo={id} data-buttons={JSON.stringify(buttons)}>
  <div class="bar">
    <span class="dots" aria-hidden="true"><span></span><span></span><span></span></span>
    <span class="title">{id}</span>
    <button type="button" class="pause" data-pause>PAUSE</button>
  </div>
  <div class="body" aria-hidden="true">
    <div class="session">
      <div class="log" data-log></div>
      <div class="band" data-band></div>
      <div class="prompt"><span class="clay">❯</span> <span data-input></span><span class="caret"></span></div>
      <p class="hint">? for shortcuts</p>
    </div>
    <aside class="pane" data-pane></aside>
    <svg class="pointer" data-pointer viewBox="0 0 12 18">
      <path d="M1 1v14l3.5-3.5 2.6 5.6 2.2-1-2.6-5.5H12z"></path>
    </svg>
  </div>
  <figcaption class="sr-only">A recorded session of the {id} plugin.</figcaption>
</figure>

<script>
  import { start } from '../scripts/demos'
  for (const root of document.querySelectorAll<HTMLElement>('[data-demo]')) start(root)
</script>

<style>
  .term {
    margin: 0;
    background: var(--term-bg);
    color: var(--term-ink);
    border: 1px solid var(--term-rule);
    border-radius: 10px;
    overflow: hidden;
    font-size: 12.5px;
    line-height: 1.6;
  }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 8px 12px;
    border-bottom: 1px solid var(--term-rule);
    color: var(--term-dim);
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--term-rule);
  }
  .pause {
    justify-self: end;
    font: inherit;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--term-dim);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .pause:hover {
    color: var(--term-ink);
  }
  .body {
    position: relative;
    height: 420px;
    overflow: hidden;
  }
  .session {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 14px 16px 10px;
  }
  .log {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 0;
    overflow: hidden;
  }
  .log :global(p),
  .pane :global(p) {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .log :global(.you) {
    color: var(--term-ink);
    margin-bottom: 6px;
  }
  .log :global(.tool)::first-letter {
    color: #7fd18b;
  }
  .clay,
  .log :global(.clay) {
    color: var(--accent);
  }
  .log :global(.warn) {
    color: #ffaf00;
  }
  .log :global(.sel) {
    width: fit-content;
    background: #504945;
    transition: background 0.6s linear;
  }
  .log :global(.dim),
  .band :global(.dim),
  .pane :global(.dim) {
    color: var(--term-dim);
  }
  .band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    min-height: 22px;
    margin-top: 1.6em;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }
  .band:global(.on) {
    opacity: 1;
    transform: none;
  }
  .term :global(.pill) {
    font-weight: 700;
    color: var(--c, #ebdbb2);
    background: #504945;
    border-radius: 999px;
    padding: 0 0.8em;
    white-space: nowrap;
    transition:
      transform 0.12s ease,
      box-shadow 0.12s ease;
  }
  .term :global(.pill.pressed) {
    transform: scale(0.92);
    box-shadow: 0 0 0 1px var(--c, #ebdbb2);
  }
  .prompt {
    margin-top: 8px;
    padding: 4px 10px;
    border: 1px solid var(--term-rule);
    border-radius: 6px;
    white-space: nowrap;
    overflow: hidden;
  }
  .caret {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 1px;
    vertical-align: text-bottom;
    background: var(--term-ink);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .hint {
    margin: 4px 0 0;
    padding-left: 10px;
    font-size: 11px;
    color: var(--term-dim);
  }
  .pane {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 52%;
    padding: 16px 18px;
    background: var(--term-bg);
    border-left: 1px solid var(--term-rule);
    transform: translateX(101%);
    transition: transform 0.45s cubic-bezier(0.19, 1, 0.22, 1);
    overflow: hidden;
  }
  .pane:global(.open) {
    transform: none;
  }
  .pane :global(header),
  .pane :global(footer) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .pane :global(header) {
    flex-wrap: nowrap;
  }
  .pane :global(header .dim) {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pane :global(.meta) {
    flex-shrink: 0;
    margin-left: auto;
  }
  .pane :global(header + .dim) {
    margin-top: 6px;
  }
  .pane :global(hr) {
    border: 0;
    border-top: 1px solid var(--term-rule);
    margin: 10px 0;
  }
  .pane :global(.h) {
    font-weight: 700;
    margin-top: 0.5em;
  }
  .pane :global(.h:first-child) {
    margin-top: 0;
  }
  .pane :global(.status) {
    margin-top: 10px;
  }
  .pointer {
    position: absolute;
    top: 0;
    left: 0;
    width: 14px;
    height: 21px;
    margin: -2px 0 0 -2px;
    fill: #fff;
    stroke: #141413;
    stroke-width: 1;
    opacity: 0;
    transform: translate(60%, 80%);
    transition:
      transform 0.7s cubic-bezier(0.65, 0, 0.35, 1),
      opacity 0.3s ease;
    pointer-events: none;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.5));
  }
  .pointer:global(.on) {
    opacity: 1;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  @media (max-width: 640px) {
    .body {
      height: 460px;
    }
    .pane {
      width: 100%;
      border-left: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }
</style>
