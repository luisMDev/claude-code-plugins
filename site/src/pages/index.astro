---
import '@fontsource/geist-mono/400.css'
import '@fontsource/geist-mono/700.css'
import Footer from '../components/Footer.astro'
import Terminal from '../components/Terminal.astro'
import { MARKETPLACE, REPO, plugins } from '../plugins'

const github = `https://github.com/${REPO}`
const underline = (text: string, char: string) => char.repeat(text.length)
const title = 'claude-code-plugins'

// What the install buttons copy: a prompt to paste into Claude Code, which runs the commands.
const prompt = (names: string[]) => {
  const one = names.length === 1
  return [
    `Install ${one ? 'this Claude Code plugin' : 'these Claude Code plugins'} from the ${MARKETPLACE} marketplace (github.com/${REPO}) by running:`,
    '',
    `claude plugin marketplace add ${REPO}`,
    ...names.map((name) => `claude plugin install ${name}@${MARKETPLACE}`),
    '',
    `Then tell me to restart Claude Code so ${one ? 'it loads' : 'they load'}.`,
  ].join('\n')
}
const everything = prompt(plugins.map((p) => p.name))
const copied = 'Install prompt copied. Paste it into Claude Code.'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>LuismDev's Claude Code plugins</title>
    <meta
      name="description"
      content="Claude Code plugins and mods by LuismDev: How, Why and Teach buttons, and a Handoff button, above the prompt."
    />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <script is:inline>
      // Before first paint, so the demo lines start hidden rather than flash.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('fx')
    </script>
  </head>
  <body>
    <nav>
      <a href="#plugins" data-scramble><span class="key">[P]</span><span data-scramble-text>PLUGINS</span></a>
      <a href="#install" data-scramble><span class="key">[I]</span><span data-scramble-text>INSTALL</span></a>
      <a href={github} data-scramble><span class="key">[G]</span><span data-scramble-text>GITHUB↗</span></a>
      <a href="https://code.claude.com/docs" data-scramble
        ><span class="key">[D]</span><span data-scramble-text>DOCS↗</span></a
      >
    </nav>

    <main>
      <header class="hero">
        <div class="stage" data-hero></div>
        <h1 aria-label={title}>
          <span aria-hidden="true"><span data-type="75">{title}</span><span class="cursor"></span></span>
          <span class="rule" aria-hidden="true">{underline(title, '=')}</span>
        </h1>
        <p class="lead">
          Small plugins that put buttons above the Claude Code prompt. Each one answers in a side pane from a fork of
          the session, so the main thread never gets an extra turn.
        </p>
        <div class="cta">
          <button type="button" class="primary" data-copy={everything} data-toast={copied} data-done="Copied">
            <span>Copy install prompt</span>
          </button>
          <span class="muted">Paste it into Claude Code. It installs every plugin here.</span>
        </div>
        <details>
          <summary>What it copies</summary>
          <pre>{everything}</pre>
        </details>
      </header>

      <section id="plugins" class="mods">
        <aside class="rail">
          <h2 class="rail-title">plugins<sup>{plugins.length}</sup></h2>
          <p class="muted">
            Claude Code plugins built on mods: small TypeScript hooks that draw their own buttons and panes in the
            terminal. Each window plays what the plugin really does.
          </p>
          <div class="cta">
            <button type="button" class="primary" data-copy={everything} data-toast={copied} data-done="Copied">
              <span>Copy install prompt</span>
            </button>
          </div>
          <a class="more" href={github}>SOURCE↗</a>
          <a class="more" href="https://code.claude.com/docs">DOCS↗</a>
        </aside>
        <div class="mods-col">
          {
            plugins.map((p) => (
              <article id={p.name} class="mod">
                <Terminal id={p.name} buttons={p.buttons} />
                <div class="mod-body">
                  <h3>
                    <a href={`${github}/tree/main/plugins/${p.name}`}>{p.name}</a>
                    <span class="version">v{p.version}</span>
                  </h3>
                  <p class="desc">{p.description}</p>
                  <div class="field">
                    <span class="label">HOOKS</span>
                    <span class="leaf">
                      {p.hooks.map((h) => (
                        <code>{h}</code>
                      ))}
                    </span>
                  </div>
                  <div class="field">
                    <span class="label">DRAWS</span>
                    <span class="leaf">{p.draws}</span>
                  </div>
                  <div class="field">
                    <span class="label">SKILLS</span>
                    {p.skills.map((s) => (
                      <span class="leaf" title={s.description.split(' Use when')[0]}>
                        <code>
                          {p.name}:{s.name}
                        </code>
                      </span>
                    ))}
                  </div>
                  <div class="actions">
                    <button
                      type="button"
                      class="install"
                      data-copy={prompt([p.name])}
                      data-toast={`Install prompt for ${p.name} copied. Paste it into Claude Code.`}
                    >
                      <svg viewBox="0 0 8 7" aria-hidden="true">
                        <path class="arrow" d="M3 0h2v3h-2zM1 3h6v1h-6zM2 4h4v1h-4zM3 5h2v1h-2z" />
                        <path class="check" d="M6 1h2v1h-2zM5 2h2v1h-2zM0 3h2v1h-2zM4 3h2v1h-2zM1 4h4v1h-4zM2 5h2v1h-2z" />
                      </svg>
                      <span>install</span>
                    </button>
                    <a class="more" href={`${github}/tree/main/plugins/${p.name}`}>
                      SOURCE↗
                    </a>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section id="install">
        <h2>INSTALL</h2>
        <p>
          Copy the prompt and paste it into Claude Code: it adds this marketplace and installs every plugin. To pick one,
          use the <span class="accent">install</span> button next to it.
        </p>
        <div class="cta">
          <button type="button" class="primary" data-copy={everything} data-toast={copied} data-done="Copied">
            <span>Copy install prompt</span>
          </button>
        </div>
        <details>
          <summary>What it copies</summary>
          <pre>{everything}</pre>
        </details>
        <p class="muted">
          In the desktop app: click <strong>+</strong> next to the prompt box, then{' '}
          <strong>Plugins → Add marketplace</strong> with <code>{REPO}</code>.
        </p>
      </section>
    </main>

    <Footer />
    <div class="toast" role="status" data-toast-host></div>

    <script>
      import '../scripts/terminal-fx'

      const host = document.querySelector<HTMLElement>('[data-hero]')
      if (host) void import('../scripts/heroes/scene').then((m) => m.mount(host))

      // Copy buttons: copy the prompt, flip to their done state, and say so in the toast.
      const toast = document.querySelector<HTMLElement>('[data-toast-host]')
      let hide = 0
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        const label = button.querySelector('span')
        const idle = label?.textContent ?? ''
        button.addEventListener('click', async () => {
          await navigator.clipboard.writeText(button.dataset.copy ?? '')
          button.dataset.state = 'copied'
          if (label && button.dataset.done) label.textContent = button.dataset.done
          setTimeout(() => {
            delete button.dataset.state
            if (label) label.textContent = idle
          }, 1800)
          if (!toast) return
          toast.textContent = button.dataset.toast ?? 'Copied.'
          toast.classList.add('show')
          clearTimeout(hide)
          hide = window.setTimeout(() => toast.classList.remove('show'), 2600)
        })
      }
    </script>
  </body>
</html>

<style is:global>
  /* The site is dark only. */
  :root {
    --bg: #141413;
    --ink: #ececec;
    --muted: #9b9b9b;
    --line: #2e2d2a;
    --panel: #1e1d1b;
    --accent: #d97757;
    --term-bg: #1a1a18;
    --term-ink: #ececec;
    --term-dim: #8a8780;
    --term-rule: #3a3a37;
    --space-dot: #5e5d58;
    color-scheme: dark;
  }
  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    overflow-x: clip;
    background: var(--bg);
    color: var(--ink);
    font: 15px/1.65 'Geist Mono', ui-monospace, monospace;
  }
  a {
    color: inherit;
  }
  code {
    font-family: inherit;
  }
  .fx [data-type]:not([data-text]) {
    visibility: hidden;
  }
</style>

<style>
  nav,
  main {
    max-width: 880px;
    margin: 0 auto;
    padding-inline: 16px;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    padding-block: 20px;
    font-size: 13px;
  }
  nav a {
    text-decoration: none;
    letter-spacing: 0.04em;
  }
  nav a:hover {
    color: var(--accent);
  }
  .key {
    color: var(--accent);
  }
  .hero {
    padding-block: 0 48px;
  }
  .stage {
    position: relative;
    left: 50%;
    width: 100vw;
    margin-left: -50vw;
    height: clamp(300px, 52vh, 480px);
    margin-bottom: 8px;
    cursor: crosshair;
    overflow: hidden;
  }
  .stage :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .stage :global(.hero-msg) {
    position: absolute;
    left: 50%;
    bottom: 12px;
    transform: translateX(-50%);
    margin: 0;
    font-size: 14px;
    color: var(--accent);
    white-space: nowrap;
    pointer-events: none;
  }
  h1 {
    font-size: clamp(28px, 7vw, 52px);
    line-height: 1.1;
    margin: 0 0 24px;
    overflow-wrap: anywhere;
  }
  .rule {
    display: block;
    color: var(--accent);
    font-size: 0.5em;
    line-height: 1;
    font-weight: 400;
    overflow: hidden;
    white-space: nowrap;
  }
  h1 .rule {
    font-size: inherit;
    letter-spacing: 0;
    line-height: 0.6;
  }
  .lead {
    max-width: 60ch;
    color: var(--muted);
    margin: 0 0 28px;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    margin: 0 0 14px;
  }
  .primary {
    font: inherit;
    font-size: 14px;
    color: var(--bg);
    background: var(--accent);
    border: 0;
    border-radius: 999px;
    padding: 10px 20px;
    cursor: pointer;
    transition: filter 0.15s ease;
  }
  .primary:hover {
    filter: brightness(1.1);
  }
  .primary[data-state='copied'] {
    filter: brightness(0.9);
  }
  .cta .muted {
    font-size: 12.5px;
  }
  details {
    margin: 0 0 8px;
    font-size: 12.5px;
  }
  summary {
    cursor: pointer;
    color: var(--muted);
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::before {
    content: '+ ';
    color: var(--accent);
  }
  details[open] summary::before {
    content: '− ';
  }
  pre {
    margin: 10px 0 0;
    padding: 12px 14px;
    overflow-x: auto;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--ink);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .install {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: inherit;
    color: var(--accent);
    background: none;
    border: 0;
    padding: 1px 0;
    cursor: pointer;
  }
  .install svg {
    width: 14px;
    height: 12px;
    fill: currentColor;
    shape-rendering: crispEdges;
  }
  .install .arrow {
    transition: transform 0.15s ease;
  }
  .install:hover .arrow {
    transform: translateY(1px);
  }
  .install .check,
  .install[data-state='copied'] .arrow {
    display: none;
  }
  .install[data-state='copied'] .check {
    display: inline;
  }
  .accent {
    color: var(--accent);
  }
  .toast {
    position: fixed;
    left: 50%;
    bottom: 24px;
    z-index: 20;
    max-width: calc(100vw - 32px);
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--panel);
    box-shadow:
      0 0 0 1px var(--line),
      0 12px 32px rgb(0 0 0 / 0.6);
    font-size: 12.5px;
    opacity: 0;
    transform: translate(-50%, 8px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
    pointer-events: none;
  }
  .toast.show {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  h2 {
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--muted);
    border-top: 1px solid var(--line);
    padding-top: 28px;
    margin: 0 0 32px;
  }
  sup {
    color: var(--accent);
    margin-left: 2px;
  }
  .mods {
    --wide: min(1360px, calc(100vw - 32px));
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 56px;
    width: var(--wide);
    margin-left: calc((100% - var(--wide)) / 2);
    padding-top: 48px;
    border-top: 1px solid var(--line);
  }
  .rail {
    position: sticky;
    top: 32px;
    align-self: start;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    font-size: 13.5px;
  }
  .rail p {
    margin: 0 0 6px;
  }
  .rail .cta {
    margin: 0;
  }
  .rail-title {
    font-size: 34px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--ink);
    border: 0;
    padding: 0;
    margin: 0;
  }
  .mod {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: 40px;
    padding-bottom: 56px;
    margin-bottom: 56px;
    border-bottom: 1px solid var(--line);
  }
  .mod:last-child {
    border-bottom: 0;
  }
  .mod-body {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }
  h3 {
    font-size: 26px;
    line-height: 1.2;
    margin: 0;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--accent);
  }
  .version {
    display: block;
    margin-top: 6px;
    font-size: 12px;
    font-weight: 400;
    color: var(--muted);
  }
  .desc {
    margin: 0;
    color: var(--muted);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 13px;
  }
  .label {
    font-size: 11.5px;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .leaf::before {
    content: '└ ';
    color: var(--muted);
  }
  .leaf code + code {
    margin-left: 8px;
  }
  .leaf code,
  #install code {
    color: var(--accent);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: auto;
  }
  .muted {
    color: var(--muted);
  }
  .more {
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--accent);
    text-decoration: none;
  }
  #install {
    margin-bottom: 64px;
  }
  #install p {
    max-width: 64ch;
  }
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 0.9em;
    margin-left: 0.08em;
    background: var(--accent);
    vertical-align: -0.05em;
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  :global(.fx) .rule {
    clip-path: inset(0 100% 0 0);
    animation: draw 0.9s steps(20) 1.6s forwards;
  }
  @keyframes draw {
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @media (max-width: 1100px) {
    .mods {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
    .rail {
      position: static;
    }
  }
  @media (max-width: 820px) {
    .mod {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
  }
</style>
