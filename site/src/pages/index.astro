---
// Titles in Silkscreen (8-bit capitals), text in JetBrains Mono.
import '@fontsource/silkscreen/400.css'
import '@fontsource/jetbrains-mono/400.css'
import '@fontsource/jetbrains-mono/700.css'
import Footer from '../components/Footer.astro'
import Terminal from '../components/Terminal.astro'
import { MARKETPLACE, REPO, TITLE, plugins, type Plugin } from '../plugins'

const github = `https://github.com/${REPO}`
// The title's rule is as long as its longest line, so it never wraps.
const rule = '='.repeat(Math.max(...TITLE.split(' ').map((word) => word.length)))

// What the install buttons copy: a prompt to paste into Claude Code, which runs
// the commands, then checks what each plugin's scripts need and does its setup.
const prompt = (list: Plugin[]) => {
  const one = list.length === 1
  const steps = (p: Plugin) => [
    ...(p.needs
      ? [
          `Check that ${p.needs.join(', ')} ${p.needs.length === 1 ? 'is' : 'are'} on my PATH. For each one missing, tell me the command that installs it on my system and run it once I say yes.`,
        ]
      : []),
    ...(p.setup ?? []),
  ]
  return [
    `Install ${one ? 'this Claude Code plugin' : 'these Claude Code plugins'} from the ${MARKETPLACE} marketplace (github.com/${REPO}) by running:`,
    '',
    `claude plugin marketplace add ${REPO}`,
    ...list.map((p) => `claude plugin install ${p.name}@${MARKETPLACE}`),
    ...list
      .filter((p) => steps(p).length > 0)
      .flatMap((p) => ['', `For ${p.name}:`, ...steps(p).map((s) => `- ${s}`)]),
    '',
    `Last, tell me to restart Claude Code so ${one ? 'it loads' : 'they load'}.`,
  ].join('\n')
}
const everything = prompt(plugins)
const copied = 'Install prompt copied. Paste it into Claude Code.'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE} · Claude Code plugins</title>
    <meta
      name="description"
      content="Claude Code plugins and mods by LuismDev: How, Why and Teach buttons and a Handoff button above the prompt, and a status line of capsules under it."
    />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <script is:inline>
      // Before first paint, so the typed title and its rule start hidden rather than flash.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('fx')
    </script>
  </head>
  <body>
    <nav class="top">
      <a href="#plugins" data-scramble><span class="key">[P]</span><span data-scramble-text>PLUGINS</span></a>
      <a href="#install" data-scramble><span class="key">[I]</span><span data-scramble-text>INSTALL</span></a>
      <a href={github} data-scramble><span class="key">[G]</span><span data-scramble-text>GITHUB↗</span></a>
      <a href="https://code.claude.com/docs" data-scramble
        ><span class="key">[D]</span><span data-scramble-text>DOCS↗</span></a
      >
      <span class="social">
        <a href="https://x.com/LuisManuel48374" target="_blank" rel="noopener" aria-label="X"
          ><svg viewBox="0 0 9 9" aria-hidden="true" fill="currentColor"
            ><path
              d="M0 0h1v1H0zM8 0h1v1H8zM1 1h1v1H1zM7 1h1v1H7zM2 2h1v1H2zM6 2h1v1H6zM3 3h1v1H3zM5 3h1v1H5zM4 4h1v1H4zM3 5h1v1H3zM5 5h1v1H5zM2 6h1v1H2zM6 6h1v1H6zM1 7h1v1H1zM7 7h1v1H7zM0 8h1v1H0zM8 8h1v1H8z"
            /></svg
          ></a
        >
        <a
          href="https://www.linkedin.com/in/luis-manuel-torres-rivera-1168b771/"
          target="_blank"
          rel="noopener"
          aria-label="LinkedIn"
          ><svg viewBox="0 0 9 9" aria-hidden="true" fill="currentColor"
            ><path
              d="M1 1h1v1H1zM1 3h1v1H1zM4 3h3v1H4zM1 4h1v1H1zM4 4h1v1H4zM7 4h1v1H7zM1 5h1v1H1zM4 5h1v1H4zM7 5h1v1H7zM1 6h1v1H1zM4 6h1v1H4zM7 6h1v1H7zM1 7h1v1H1zM4 7h1v1H4zM7 7h1v1H7z"
            /></svg
          ></a
        >
        <a href="https://github.com/luisMDev" target="_blank" rel="noopener" aria-label="GitHub"
          ><svg viewBox="0 0 9 9" aria-hidden="true" fill="currentColor"
            ><path
              d="M1 0h1v1H1zM7 0h1v1H7zM1 1h2v1H1zM6 1h2v1H6zM1 2h7v1H1zM0 3h9v1H0zM0 4h3v1H0zM4 4h1v1H4zM6 4h3v1H6zM0 5h9v1H0zM1 6h7v1H1zM0 7h1v1H0zM3 7h3v1H3zM1 8h1v1H1zM3 8h3v1H3z"
            /></svg
          ></a
        >
      </span>
    </nav>

    <header>
      <div class="stage" data-hero></div>
      <div class="intro wide">
        <h1 aria-label={TITLE}>
          <span class="name" aria-hidden="true"><span data-type="75">{TITLE}</span><span class="cursor"></span></span>
          <span class="rule" aria-hidden="true">{rule}</span>
        </h1>
        <div class="copy">
          <p class="lead">
            Small plugins around the Claude Code prompt. Buttons above it answer in a side pane from a fork of the
            session, so the main thread never gets an extra turn; a status line under it shows where you are, the
            branch and its PR, your usage and the context window.
          </p>
          <button type="button" class="primary" data-copy={everything} data-toast={copied} data-done="Copied">
            <span>Copy install prompt</span>
          </button>
          <details>
            <summary>What it copies</summary>
            <pre>{everything}</pre>
          </details>
        </div>
      </div>
    </header>

    <main>
      <section id="plugins" class="split wide">
        <aside class="rail">
          <h2>plugins<sup>{plugins.length}</sup></h2>
          <p class="muted">
            Built on mods: small TypeScript hooks that draw their own buttons and panes in the terminal, or set its
            status line. Each window plays what the plugin really does.
          </p>
          <div class="actions">
            <a class="link" href={github}>SOURCE↗</a>
            <a class="link" href="https://code.claude.com/docs">DOCS↗</a>
          </div>
        </aside>
        <div>
          {
            plugins.map((p) => (
              <article id={p.name} class="mod">
                <Terminal id={p.name} buttons={p.buttons} />
                <div class="mod-body">
                  <h3>
                    <a href={`${github}/tree/main/plugins/${p.name}`}>{p.name}</a>
                    <span class="version">v{p.version}</span>
                  </h3>
                  <p class="muted">{p.description}</p>
                  <dl class="facts">
                    <dt>Hooks</dt>
                    <dd>
                      {p.hooks.map((h) => (
                        <code>{h}</code>
                      ))}
                    </dd>
                    <dt>Draws</dt>
                    <dd>{p.draws}</dd>
                    {p.skills.length > 0 && <dt>Skills</dt>}
                    {p.skills.map((s) => (
                      <dd title={s.description.split(' Use when')[0]}>
                        <code>
                          {p.name}:{s.name}
                        </code>
                      </dd>
                    ))}
                    {p.needs && <dt>Needs</dt>}
                    {p.needs && (
                      <dd>
                        {p.needs.map((n) => (
                          <code>{n}</code>
                        ))}
                      </dd>
                    )}
                  </dl>
                  <div class="actions">
                    <button
                      type="button"
                      class="install"
                      data-copy={prompt([p])}
                      data-toast={`Install prompt for ${p.name} copied. Paste it into Claude Code.`}
                    >
                      <svg viewBox="0 0 8 7" aria-hidden="true">
                        <path class="arrow" d="M3 0h2v3h-2zM1 3h6v1h-6zM2 4h4v1h-4zM3 5h2v1h-2z" />
                        <path class="check" d="M6 1h2v1h-2zM5 2h2v1h-2zM0 3h2v1h-2zM4 3h2v1h-2zM1 4h4v1h-4zM2 5h2v1h-2z" />
                      </svg>
                      <span>install</span>
                    </button>
                    <a class="link" href={`${github}/tree/main/plugins/${p.name}`}>
                      SOURCE↗
                    </a>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section id="install" class="split wide">
        <aside class="rail">
          <h2>install</h2>
        </aside>
        <div class="copy">
          <p>
            Copy the prompt and paste it into Claude Code: it adds this marketplace, installs every plugin, and checks
            the tools the status line script runs. To pick one, use the <span class="accent">install</span> button next to it.
          </p>
          <button type="button" class="primary" data-copy={everything} data-toast={copied} data-done="Copied">
            <span>Copy install prompt</span>
          </button>
          <details>
            <summary>What it copies</summary>
            <pre>{everything}</pre>
          </details>
          <p class="muted">
            In the desktop app: click <strong>+</strong> next to the prompt box, then{' '}
            <strong>Plugins → Add marketplace</strong> with <code class="accent">{REPO}</code>.
          </p>
        </div>
      </section>
    </main>

    <Footer />
    <div class="toast" role="status" data-toast-host></div>

    <script>
      import '../scripts/terminal-fx'

      const host = document.querySelector<HTMLElement>('[data-hero]')
      if (host) void import('../scripts/heroes/scene').then((m) => m.mount(host))

      // Copy buttons: copy the prompt, flip to their done state, and say so in the toast.
      const toast = document.querySelector<HTMLElement>('[data-toast-host]')
      let hide = 0
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        const label = button.querySelector('span')
        const idle = label?.textContent ?? ''
        button.addEventListener('click', async () => {
          await navigator.clipboard.writeText(button.dataset.copy ?? '')
          button.dataset.state = 'copied'
          if (label && button.dataset.done) label.textContent = button.dataset.done
          setTimeout(() => {
            delete button.dataset.state
            if (label) label.textContent = idle
          }, 1800)
          if (!toast) return
          toast.textContent = button.dataset.toast ?? 'Copied.'
          toast.classList.add('show')
          clearTimeout(hide)
          hide = window.setTimeout(() => toast.classList.remove('show'), 2600)
        })
      }
    </script>
  </body>
</html>

<style is:global>
  /* The site is dark only. */
  :root {
    --bg: #141413;
    --ink: #ececec;
    --muted: #9b9b9b;
    --line: #2e2d2a;
    --panel: #1e1d1b;
    --accent: #d97757;
    --term-bg: #1a1a18;
    --term-ink: #ececec;
    --term-dim: #8a8780;
    --term-rule: #3a3a37;
    --space-dot: #5e5d58;
    /* One measure and one rhythm for every section. */
    --wide: min(1360px, calc(100vw - 32px));
    --rail: 280px;
    --gap: 56px;
    --section: 144px;
    --small: 13px;
    --label: 11px;
    --chip: #262522; /* the fill of a button drawn in the terminal */
    /* Type: Silkscreen for titles, scaled down as its capitals run wide; JetBrains Mono for text. */
    --font-title: 'Silkscreen', ui-monospace, monospace;
    --font-body: 'JetBrains Mono', ui-monospace, monospace;
    --title-k: 0.78;
    --title-weight: 400;
    --title-lh: 1.05;
    color-scheme: dark;
  }
  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    overflow-x: clip;
    background: var(--bg);
    color: var(--ink);
    font: 15px/1.65 var(--font-body);
  }
  a {
    color: inherit;
  }
  code {
    font-family: inherit;
  }
  .fx [data-type]:not([data-text]) {
    visibility: hidden;
  }
  h1,
  h2,
  h3 {
    font-family: var(--font-title);
    font-weight: var(--title-weight);
  }
</style>

<style>
  .wide {
    width: var(--wide);
    margin-inline: auto;
  }
  .muted {
    color: var(--muted);
  }
  .accent {
    color: var(--accent);
  }
  .key {
    color: var(--accent);
  }
  /* Buttons drawn in the terminal: square blocks of colour, no border;
     hovering inverts them, like reverse video. */
  .link,
  .install,
  .top > a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    font: inherit;
    font-size: var(--small);
    letter-spacing: 0.06em;
    color: var(--accent);
    background: var(--chip);
    border: 0;
    border-radius: 0;
    text-decoration: none;
    cursor: pointer;
  }
  .link:hover,
  .install:hover,
  .top > a:hover,
  .link:focus-visible,
  .install:focus-visible,
  .top > a:focus-visible {
    color: var(--bg);
    background: var(--accent);
    outline: none;
  }

  /* Top nav */
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
    width: var(--wide);
    margin: 0 auto;
    padding-block: 20px;
    font-size: var(--small);
  }
  .top > a {
    color: var(--ink);
  }
  .top > a:hover .key,
  .top > a:focus-visible .key {
    color: var(--bg);
  }
  .social {
    display: flex;
    gap: 14px;
    margin-left: auto;
  }
  .social a {
    display: flex;
    color: var(--muted);
  }
  .social a:hover,
  .social a:focus-visible {
    color: var(--accent);
  }
  .social svg {
    width: 16px;
    height: 16px;
    shape-rendering: crispEdges;
  }

  /* The animated header, full bleed */
  .stage {
    height: clamp(300px, 52vh, 480px);
    cursor: crosshair;
    overflow: hidden;
  }
  .stage :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Intro: the title opposite the copy */
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 32px var(--gap);
    align-items: end;
    padding-top: 96px;
  }
  h1 {
    margin: 0;
    font-size: calc(clamp(40px, 6vw, 80px) * var(--title-k));
    line-height: var(--title-lh);
  }
  .name {
    display: block;
    max-width: 14ch; /* one word a line, the cursor included, in narrow faces too */
  }
  .rule {
    display: block;
    margin-top: 0.12em;
    color: var(--accent);
    font-weight: 400;
    line-height: 0.6;
    white-space: nowrap;
  }
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 0.85em;
    margin-left: 0.1em;
    background: var(--accent);
    vertical-align: -0.05em;
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  :global(.fx) .rule {
    clip-path: inset(0 100% 0 0);
    animation: draw 0.9s steps(12) 1.6s forwards;
  }
  @keyframes draw {
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    max-width: 600px;
  }
  .copy p {
    margin: 0;
  }
  .lead {
    color: var(--muted);
  }

  /* Labels: the one small uppercase style */
  dt {
    font-size: var(--label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Buttons */
  .primary {
    font: inherit;
    font-size: 14px;
    color: var(--bg);
    background: var(--accent);
    border: 0;
    border-radius: 0;
    padding: 9px 18px;
    cursor: pointer;
  }
  .primary:hover,
  .primary:focus-visible,
  .primary[data-state='copied'] {
    background: var(--ink);
    outline: none;
  }
  .install svg {
    width: 14px;
    height: 12px;
    fill: currentColor;
    shape-rendering: crispEdges;
  }
  .install .arrow {
    transition: transform 0.15s ease;
  }
  .install:hover .arrow {
    transform: translateY(1px);
  }
  .install .check,
  .install[data-state='copied'] .arrow {
    display: none;
  }
  .install[data-state='copied'] .check {
    display: inline;
  }
  details {
    font-size: var(--small);
  }
  summary {
    cursor: pointer;
    color: var(--muted);
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::before {
    content: '+ ';
    color: var(--accent);
  }
  details[open] summary::before {
    content: '− ';
  }
  pre {
    margin: 10px 0 0;
    padding: 12px 14px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  /* Sections: a rail on the left, the content on the right */
  .split {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    gap: var(--gap);
    margin-top: var(--section);
  }
  .rail {
    position: sticky;
    top: 32px;
    align-self: start;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    font-size: var(--small);
  }
  .rail p {
    margin: 0;
  }
  h2 {
    margin: 0;
    font-size: calc(32px * var(--title-k));
    line-height: 1.1;
  }
  /* The plugin count: a square cell on the terminal's button fill. */
  sup {
    display: inline-grid;
    place-items: center;
    width: 1.5em;
    height: 1.5em;
    margin-left: 0.35em;
    font-size: 0.6em;
    line-height: 1;
    vertical-align: 0.45em;
    color: var(--accent);
    background: var(--chip);
  }

  /* One plugin */
  .mod {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: 40px;
  }
  .mod + .mod {
    margin-top: var(--section);
  }
  .mod-body {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }
  .mod-body p {
    margin: 0;
  }
  h3 {
    margin: 0;
    font-size: calc(24px * var(--title-k));
    line-height: 1.2;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--accent);
  }
  .version {
    display: block;
    margin-top: 6px;
    font-size: var(--label);
    font-weight: 400;
    color: var(--muted);
  }
  .facts {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    font-size: var(--small);
  }
  .facts dt:not(:first-child) {
    margin-top: 10px;
  }
  .facts dd {
    margin: 0;
  }
  .facts dd::before {
    content: '└ ';
    color: var(--muted);
  }
  .facts code {
    color: var(--accent);
  }
  .facts code + code {
    margin-left: 8px;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
  }


  .toast {
    position: fixed;
    left: 50%;
    bottom: 24px;
    z-index: 20;
    max-width: calc(100vw - 32px);
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--panel);
    box-shadow:
      0 0 0 1px var(--line),
      0 12px 32px rgb(0 0 0 / 0.6);
    font-size: var(--small);
    opacity: 0;
    transform: translate(-50%, 8px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
    pointer-events: none;
  }
  .toast:global(.show) {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (max-width: 1100px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .rail {
      position: static;
    }
  }
  @media (max-width: 820px) {
    .intro,
    .mod {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
  }
</style>
